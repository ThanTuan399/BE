datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Bảng Xác thực trung tâm (Tài khoản)
model NguoiDung {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tenDangNhap String    @unique
  matKhau     String
  vaiTro      String    // "BAC_SI", "BENH_NHAN", "ADMIN"

  bacSi       BacSi?
  benhNhan    BenhNhan?
}

// 1. Bảng Bác sĩ
model BacSi {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  nguoiDungId String    @unique @db.ObjectId
  hoTen       String
  soDienThoai String?

  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id])
  lichKhams   LichKham[]
}

// 2. Bảng Bệnh nhân
model BenhNhan {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  nguoiDungId String    @unique @db.ObjectId
  hoTen       String
  soDienThoai String

  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id])
  lichKhams   LichKham[]
}

// 3. Bảng Lịch khám
model LichKham {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  bacSiId         String    @db.ObjectId
  benhNhanId      String    @db.ObjectId
  thoiGianBatDau  DateTime
  thoiGianKetThuc DateTime
  trangThai       String    @default("Chờ khám")

  bacSi    BacSi     @relation(fields: [bacSiId], references: [id])
  benhNhan BenhNhan  @relation(fields: [benhNhanId], references: [id])
  hoSoKham HoSoKham?
}

// 4. Bảng Hồ sơ khám
model HoSoKham {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  lichKhamId String    @unique @db.ObjectId
  trieuChung String
  chanDoan   String

  lichKham  LichKham   @relation(fields: [lichKhamId], references: [id])
  donThuocs DonThuoc[]
}

// 5. Bảng Đơn thuốc
model DonThuoc {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  hoSoKhamId   String   @db.ObjectId
  chiTietThuoc String

  hoSoKham HoSoKham @relation(fields: [hoSoKhamId], references: [id])
}