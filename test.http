### 4. Xem Toàn bộ Lịch khám Phòng khám

### 1. [THÊM] Admin thêm Bác sĩ mới
POST http://localhost:5000/api/admin/bac-si
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOiI2YTllZDc4ODkyNmJhMTA3ZGZmZTcxZjkiLCJ0ZW5EYW5nTmhhcCI6ImFkbWluMDEiLCJ2YWlUcm8iOiJBRE1JTiIsImJhY1NpSWQiOm51bGwsImlhdCI6MTc4ODc5NjMzNiwiZXhwIjoxNzg4ODgyNzM2fQ.jkZ4bucG8svZ7TRXYLQ_RFx2UkZBuVMBZHDVt8j6sI0
Content-Type: application/json

{
  "tenDangNhap": "bacsi_tran",
  "matKhau": "123456",
  "hoTen": "BS. Trần Văn C",
  "soDienThoai": "0911223344"
}

